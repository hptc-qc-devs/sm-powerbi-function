{
  "name": "sm-powerbi-function",
  "version": "0.1.0",
  "description": "Self-hosted Azure Function that connects SurveyMonkey surveys to Power BI",
  "main": "src/functions/*.js",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hptc-qc-devs/sm-powerbi-function.git"
  },
  "bugs": {
    "url": "https://github.com/hptc-qc-devs/sm-powerbi-function/issues"
  },
  "homepage": "https://github.com/hptc-qc-devs/sm-powerbi-function#readme",
  "keywords": [
    "surveymonkey",
    "powerbi",
    "azure-functions",
    "etl",
    "survey-data",
    "connector"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "func start",
    "test": "node --test test/*.test.js",
    "test:integration": "STORAGE_CONNECTION_STRING=UseDevelopmentStorage=true node --test test/*.test.js",
    "azurite": "azurite --location .azurite --skipApiVersionCheck",
    "setup-oauth": "node scripts/setupOAuth.js"
  },
  "dependencies": {
    "@azure/functions": "^4.5.0",
    "@azure/identity": "^4.4.1",
    "@azure/keyvault-secrets": "^4.8.0",
    "@azure/storage-blob": "^12.33.0"
  },
  "devDependencies": {
    "azurite": "^3.34.0"
  }
}
